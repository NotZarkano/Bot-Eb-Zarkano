# Configure estes valores nas variáveis do host (Square Cloud).
# Nunca coloque os valores de verdade aqui nem no código.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Chave Open Cloud do Roblox (leitura do grupo 7797329).
ROBLOX_OPEN_CLOUD_API_KEY=
# Mesmo banco (Neon) do site: lê a tabela discord_links.
DATABASE_URL=
# Opcional: só para hosts que exigem porta aberta (ex.: Render define PORT
# sozinho). Na Square Cloud não precisa.
# KEEP_ALIVE=true
